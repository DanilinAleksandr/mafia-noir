{
  "name": "mafia-online",
  "version": "0.1.0",
  "private": true,
  "description": "Мафия Online — веб-игра для компании друзей",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:engine": "npm run test --workspace @mafia/engine",
    "test:protocol": "npm run test --workspace @mafia/protocol",
    "test:server": "npm run test --workspace @mafia/server",
    "test:web": "npm run test --workspace @mafia/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently --kill-others --names server,web --prefix-colors yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @mafia/server",
    "dev:web": "npm run dev --workspace @mafia/web",
    "build": "npm run build --workspace @mafia/web",
    "e2e": "npm run e2e --workspace @mafia/web",
    "screens": "npm run screens --workspace @mafia/web",
    "bots": "npm run bots --workspace @mafia/server --",
    "scene-shots": "npm run scene-shots --workspace @mafia/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
